# Shared local development defaults. Optionally customize the untracked .env.
# Neo4j's initial username is always neo4j.
NEO4J_PASSWORD=devpassword
MINIO_ROOT_USER=redsocial
MINIO_ROOT_PASSWORD=redsocial-minio-local

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MINIO_CONSOLE_PORT=9001

# Used only with docker-compose.dev.yml (backend running on the host).
MINIO_API_PORT=9000
REDIS_PORT=6379

# Public image URL prefix (same-origin proxy by default).
MEDIA_PUBLIC_URL=/media/

# Reserved for Web Push; not required by the base infrastructure.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
